generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity", "content", "game"]
}

enum GameSessionStatus {
  LOBBY
  ACTIVE
  REVEAL
  FINISHED

  @@schema("game")
}

enum RankingItemStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("content")
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  displayName  String
  canHostGames Boolean @default(false)

  accounts ExternalAccount[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  topics              Topic[]
  gameSessions        GameSession[]
  sessionParticipants SessionParticipant[]

  @@schema("identity")
}

model ExternalAccount {
  id String @id @default(uuid()) @db.Uuid

  provider          String
  providerAccountId String

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@schema("identity")
}

model Topic {
  id          String  @id @default(uuid()) @db.Uuid
  title       String
  description String?

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  rankingItems RankingItem[]
  gameSessions GameSession[]

  @@unique([ownerId, title])
  @@schema("content")
}

model RankingItem {
  id     String            @id @default(uuid()) @db.Uuid
  text   String
  status RankingItemStatus @default(APPROVED)

  topicId String @db.Uuid
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessionItems SessionItem[]

  @@unique([topicId, text])
  @@schema("content")
}

model GameSession {
  id String @id @default(uuid()) @db.Uuid

  hostUserId String @db.Uuid
  hostUser   User   @relation(fields: [hostUserId], references: [id])

  topicId String @db.Uuid
  topic   Topic  @relation(fields: [topicId], references: [id])

  status   GameSessionStatus @default(LOBBY)
  joinCode String            @unique

  currentPosition Int?

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  items        SessionItem[]
  participants SessionParticipant[]

  @@schema("game")
}

model SessionItem {
  id String @id @default(uuid()) @db.Uuid

  sessionId String      @db.Uuid
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  sourceRankingItemId String?      @db.Uuid
  sourceRankingItem   RankingItem? @relation(fields: [sourceRankingItemId], references: [id], onDelete: SetNull)

  text     String
  position Int

  rankings Ranking[]

  @@unique([sessionId, position])
  @@unique([sessionId, sourceRankingItemId])
  @@schema("game")
}

model SessionParticipant {
  id String @id @default(uuid()) @db.Uuid

  sessionId String      @db.Uuid
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  displayName String
  joinedAt    DateTime @default(now())

  rankings Ranking[]

  @@unique([sessionId, userId])
  @@schema("game")
}

model Ranking {
  id String @id @default(uuid()) @db.Uuid

  participantId String             @db.Uuid
  participant   SessionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  sessionItemId String      @db.Uuid
  sessionItem   SessionItem @relation(fields: [sessionItemId], references: [id], onDelete: Cascade)

  rank Int

  createdAt DateTime @default(now())

  @@unique([participantId, rank])
  @@unique([participantId, sessionItemId])
  @@schema("game")
}
